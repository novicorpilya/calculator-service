# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# These are exposed to the browser (VITE_ prefix)
# ============================================

# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: API URL (if using custom backend)
VITE_API_URL=http://localhost:3000/api

# ============================================
# SERVER-ONLY ENVIRONMENT VARIABLES
# These MUST be set in Vercel Dashboard only!
# NEVER add VITE_ prefix to these - they are secrets!
# ============================================

# Supabase Service Role Key (for serverless functions)
# Get from: https://app.supabase.com/project/_/settings/api
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend API Key (for email notifications)
# Get from: https://resend.com/api-keys
# RESEND_API_KEY=your_resend_api_key_here
